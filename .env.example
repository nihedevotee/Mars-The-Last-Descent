# Mars: The Last Descent - Example Environment Template
# Copy this file to .env.local and add your real keys.
#
# SECURITY WARNING:
# Any VITE_* variable is bundled into public client JavaScript during `npm run build`.
# For public deployments (GitHub Pages, etc.), use a server-side proxy (/api/chat)
# with GEMINI_API_KEY set on the server instead of exposing VITE_GEMINI_API_KEY.

# Server-side Gemini API Key (used by Vite /api/chat proxy and Vercel api/chat.ts - NOT exposed in client JS)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Deployed proxy endpoint URL if hosting frontend on static hosting (e.g. GitHub Pages)
# Example: https://your-project.vercel.app/api/chat
VITE_CHAT_PROXY_URL=

# Optional client-side Gemini API key (ONLY for trusted local testing without a proxy; bundled publicly)
VITE_GEMINI_API_KEY=

# Optional Gemini model override (defaults to gemini-3.6-flash with gemini-3.5-flash fallback)
VITE_GEMINI_MODEL=gemini-3.6-flash

# NASA Open API Key (Register free at https://api.nasa.gov or use DEMO_KEY)
VITE_NASA_API_KEY=DEMO_KEY
